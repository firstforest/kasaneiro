{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rustfmt.sh",
            "timeout": 30,
            "statusMessage": "rustfmt"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rustfmt-changed.sh",
            "timeout": 30,
            "statusMessage": "rustfmt (変更した .rs)"
          }
        ]
      }
    ]
  }
}
